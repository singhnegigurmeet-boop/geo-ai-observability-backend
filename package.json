{
  "name": "geo-ai-observability-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented GEO and AI observability backend.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "clean": "node scripts/clean-build-output.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:schema": "node scripts/run-infrastructure-tests.mjs schema",
    "test:integration": "node scripts/run-infrastructure-tests.mjs outbox identity analysis hierarchy expansion llm prompts providers reporting budgets realProviders operations",
    "test:e2e": "node scripts/run-infrastructure-tests.mjs e2e",
    "test:e2e:full": "node scripts/run-infrastructure-tests.mjs budgets operations outbox full",
    "test:all": "npm run test:unit && npm run test:schema && npm run test:integration && npm run test:e2e",
    "verify": "npm run typecheck && npm run test:all && npm run build && git diff --check",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "outbox:dev": "tsx watch src/outbox/main.ts",
    "outbox:start": "node dist/outbox/main.js",
    "analysis-worker:dev": "tsx watch src/analysis-worker/main.ts",
    "analysis-worker:start": "node dist/analysis-worker/main.js",
    "analysis-item-worker:dev": "tsx watch src/analysis-item-worker/main.ts",
    "analysis-item-worker:start": "node dist/analysis-item-worker/main.js",
    "llm-run-worker:dev": "tsx watch src/llm-run-worker/main.ts",
    "llm-run-worker:start": "node dist/llm-run-worker/main.js",
    "prompt-worker:dev": "tsx watch src/prompt-worker/main.ts",
    "prompt-worker:start": "node dist/prompt-worker/main.js",
    "mock-provider-worker:dev": "tsx watch src/mock-provider-worker/main.ts",
    "mock-provider-worker:start": "node dist/mock-provider-worker/main.js",
    "openai-provider-worker:dev": "tsx watch src/provider-worker/main.ts openai",
    "openai-provider-worker:start": "node dist/provider-worker/main.js openai",
    "gemini-provider-worker:dev": "tsx watch src/provider-worker/main.ts gemini",
    "gemini-provider-worker:start": "node dist/provider-worker/main.js gemini",
    "claude-provider-worker:dev": "tsx watch src/provider-worker/main.ts claude",
    "claude-provider-worker:start": "node dist/provider-worker/main.js claude",
    "scoring-worker:dev": "tsx watch src/scoring-worker/main.ts",
    "scoring-worker:start": "node dist/scoring-worker/main.js",
    "scheduler-worker:dev": "tsx watch src/scheduler-worker/main.ts",
    "scheduler-worker:start": "node dist/scheduler-worker/main.js",
    "notification-worker:dev": "tsx watch src/notification-worker/main.ts",
    "notification-worker:start": "node dist/notification-worker/main.js",
    "infra:up": "docker compose up -d --wait postgres rabbitmq",
    "infra:down": "docker compose down",
    "infra:test:up": "docker compose --profile test up -d --wait postgres-test rabbitmq-test",
    "infra:test:down": "docker compose --profile test rm -s -f -v postgres-test rabbitmq-test",
    "docker:up": "docker compose up -d --build",
    "docker:api": "docker compose up -d --build api",
    "docker:logs": "docker compose logs -f api"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
