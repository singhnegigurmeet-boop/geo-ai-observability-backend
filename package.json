{
  "name": "geo-ai-observability-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented GEO and AI observability backend.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "clean": "node scripts/clean-build-output.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:migrations": "node scripts/run-migration-tests.mjs",
    "test:phase2": "node scripts/run-phase2-integration-tests.mjs",
    "test:phase3": "node scripts/run-phase3-integration-tests.mjs",
    "test:phase4": "node scripts/run-phase4-integration-tests.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "outbox:dev": "tsx watch src/outbox/main.ts",
    "outbox:start": "node dist/outbox/main.js",
    "infra:up": "docker compose up -d postgres rabbitmq redis elasticsearch",
    "infra:down": "docker compose down",
    "infra:test:up": "docker compose --profile test up -d postgres-test rabbitmq-test",
    "infra:test:down": "docker compose --profile test stop postgres-test rabbitmq-test",
    "docker:up": "docker compose up -d --build api",
    "docker:logs": "docker compose logs -f api"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.1",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
