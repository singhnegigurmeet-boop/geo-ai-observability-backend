NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/geo_observability
RABBITMQ_URL=amqp://guest:guest@localhost:5672?heartbeat=30
RABBITMQ_EXCHANGE=geo.v6.main
RABBITMQ_DEAD_LETTER_EXCHANGE=geo.v6.dlx
RABBITMQ_CONFIRM_TIMEOUT_MS=10000
ANALYSIS_RUN_WORKER_PREFETCH=5
ANALYSIS_RUN_ITEM_WORKER_PREFETCH=10
LLM_RUN_WORKER_PREFETCH=10
PROMPT_WORKER_PREFETCH=10
MOCK_PROVIDER_WORKER_PREFETCH=10
REAL_PROVIDER_WORKER_PREFETCH=5
SCORING_WORKER_PREFETCH=10
NOTIFICATION_WORKER_PREFETCH=10
SCHEDULER_BATCH_SIZE=25
SCHEDULER_POLL_INTERVAL_MS=5000
ENABLE_REAL_PROVIDERS=false
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_TIMEOUT_MS=30000
GEMINI_TIMEOUT_MS=30000
CLAUDE_TIMEOUT_MS=30000
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
USER_SESSION_TTL_SECONDS=2592000
ANONYMOUS_SESSION_TTL_SECONDS=604800

OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
